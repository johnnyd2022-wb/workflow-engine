[app]
environment = local
debug = true
host = 0.0.0.0
port = 8005
keepass_session_secret_entry = workflow-engine/FLASK_SECRET_KEY_LOCAL

[database]
host = localhost
port = 8401
name = workflow-engine
user = postgres
password = YOUR_PASSWORD_HERE
# Optional connection-pool tuning (defaults shown; SQLAlchemy defaults are 5/10).
# Keep  workers * (pool_size + max_overflow)  under Postgres max_connections.
# pool_size = 5
# max_overflow = 10
# pool_recycle = 1800
# pool_timeout = 30


[xero]
client_id = YOUR_LOCAL_XERO_CLIENT_ID
client_secret = YOUR_LOCAL_XERO_CLIENT_SECRET
redirect_uri = https://localhost:8005/crm/xero/callback

[email]
sender_email = your-email@example.com
receiver_email = your-email@example.com
# Shown on the sign-in form for a forgotten password or a locked account (GL-A04).
support_email = support@biz-e.app

[features]
# Multiple sites (GL-P07); also needs the multi_site subscription and the org's own switch.
multi_site_enabled = true
invoice_button_enabled = true
schedule_enabled = true
crm_enabled = true
compliant_enabled = true
workflow_engine_enabled = true

[observability]
log_level = DEBUG
log_format = console
otel_enabled = true
otel_service_name = workflow-engine
otel_sample_rate = 1.0
otel_exporter_endpoint = http://localhost:4317
otel_exporter_protocol = grpc
otel_capture_metrics = true
rum_enabled = true
rum_collector_url = /telemetry
rum_sample_rate = 1.0
rum_mask_inputs = true
rum_faro_upstream = http://localhost:12347
rum_posthog_upstream = http://localhost:8000
rum_posthog_capture_upstream = http://localhost:13000
rum_posthog_replay_upstream = http://localhost:13001
rum_posthog_feature_flags_upstream = http://localhost:13002
rum_posthog_api_key =
grafana_admin_user = admin
posthog_site_url = http://localhost:8000
keepass_posthog_secret_entry = workflow-engine/observability/posthog_secret
keepass_posthog_encryption_salt_keys_entry = workflow-engine/observability/posthog_encryption_salt_keys
keepass_grafana_admin_password_entry = workflow-engine/observability/grafana_admin_password
keepass_posthog_project_api_key_entry = workflow-engine/observability/posthog_project_api_key

# [ratelimit]
# Local dev runs one process, so in-memory counts are already shared. To try a Valkey locally:
# host = 127.0.0.1, port, db, and the password in VALKEY_PASSWORD (or KeePassXC
# workflow-engine/VALKEY_PASSWORD_LOCAL). An explicit storage_uri = redis://... still wins.

[google_sign_in]
# Requires OAuth credentials from KeePassXC locally or protected environment variables.
enabled = true
redirect_uri = https://dev.biz-e.app/auth/google/callback
keepass_client_id_entry = workflow-engine/GOOGLE_CLIENT_ID
keepass_client_secret_entry = workflow-engine/GOOGLE_CLIENT_SECRET

[mcp]
# Public MCP (roadmap 8.2): the app is the OAuth authorization server for AI assistants.
# issuer: this app's public origin. resource: the MCP server's URL; every assistant token
# is bound to it, and a token for any other audience is refused.
issuer = http://localhost:8005
resource = http://localhost:8030/mcp
# bearer_internal_only: accept an assistant's token only from the MCP container on the private
# Docker network. A bearer request that came through Cloudflare (CF-Connecting-IP / CF-Ray) is
# refused 401 before the token is looked up (design review S1).
bearer_internal_only = false
