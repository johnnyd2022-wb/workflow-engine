[app]
environment = production
debug = false
host = host.docker.internal
port = 5000

[database]
host = host.docker.internal
port = 8432
name = workflow-engine
user = postgres
# The database password comes from the deployment environment, NOT this file:
# set POSTGRES_PASSWORD from the secret store. App startup fails if unset.
password =
# Optional connection-pool tuning (defaults shown; SQLAlchemy defaults are 5/10).
# Keep  workers * (pool_size + max_overflow)  under Postgres max_connections.
# pool_size = 5
# max_overflow = 10
# pool_recycle = 1800
# pool_timeout = 30


[xero]
client_id = YOUR_PROD_XERO_CLIENT_ID
client_secret = YOUR_PROD_XERO_CLIENT_SECRET

[email]
sender_email = your-email@example.com
receiver_email = production-email@example.com

[features]
invoice_button_enabled = true
schedule_enabled = true
crm_enabled = true
compliant_enabled = true
workflow_engine_enabled = true

[observability]
log_level = INFO
log_format = json
otel_enabled = true
otel_service_name = workflow-engine
otel_sample_rate = 0.1
otel_exporter_endpoint = http://localhost:4317
otel_exporter_protocol = grpc
otel_capture_metrics = true
rum_enabled = true
rum_collector_url = /telemetry
rum_sample_rate = 1.0
rum_mask_inputs = true
rum_faro_upstream = http://localhost:12347
rum_posthog_upstream = http://localhost:8000
rum_posthog_api_key =

# [ratelimit]
# Shared storage for auth rate limits. REQUIRED for any multi-worker deploy --
# without it each gunicorn worker keeps its own bucket and the limits are diluted.
# storage_uri = redis://localhost:6379/0
