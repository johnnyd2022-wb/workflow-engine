[app]
environment = production
debug = false
host = host.docker.internal
port = 5000

[database]
# The app and its database share the `workflow-engine-prod` Docker network (scripts/prod_db.sh),
# so the app reaches the database by container name and the port is never published.
host = workflow-engine-prod-db
port = 5432
name = workflow-engine
user = workflow_rw
# The database password comes from the deployment environment, NOT this file:
# set POSTGRES_PASSWORD from the secret store. App startup fails if unset.
password =
# Optional connection-pool tuning (defaults shown; SQLAlchemy defaults are 5/10).
# Keep  workers * (pool_size + max_overflow)  under Postgres max_connections.
# pool_size = 5
# max_overflow = 10
# pool_recycle = 1800
# pool_timeout = 30


[xero]
# Credentials come from XERO_CLIENT_ID / XERO_CLIENT_SECRET in the deployment environment.
client_id =
client_secret =
redirect_uri = https://biz-e.app/crm/xero/callback

[evidence]
; Uploads live on a named Docker volume mounted here (scripts/run_prod.sh), so they survive redeploys.
storage_root = /data/evidence
max_file_size_mb = 10
allowed_mime_types = image/jpeg, image/png, application/pdf

[process_docs]
storage_root = /data/process_docs
max_file_size_mb = 20
allowed_mime_types = application/pdf, application/msword, application/vnd.openxmlformats-officedocument.wordprocessingml.document, text/markdown, text/plain

[email]
sender_email = your-email@example.com
receiver_email = production-email@example.com

[features]
invoice_button_enabled = true
schedule_enabled = true
crm_enabled = true
compliant_enabled = true
workflow_engine_enabled = true

[observability]
log_level = INFO
log_format = json
# Keep both pipelines off until their endpoints name a real, non-loopback collector: inside the
# container `localhost` is the container itself (and :8000 is this app). Set the endpoints first,
# THEN the switch, and enable the matching grafana_data_enabled / posthog_data_enabled consent flag.
otel_enabled = false
otel_service_name = workflow-engine
otel_sample_rate = 0.1
otel_exporter_endpoint = http://localhost:4317
otel_exporter_protocol = grpc
otel_capture_metrics = true
rum_enabled = false
rum_collector_url = /telemetry
rum_sample_rate = 1.0
rum_mask_inputs = true
rum_faro_upstream = http://localhost:12347
rum_posthog_upstream = http://localhost:8000
rum_posthog_api_key =

# [ratelimit]
# Shared storage for auth rate limits. REQUIRED for any multi-worker deploy --
# without it each gunicorn worker keeps its own bucket and the limits are diluted.
# storage_uri = redis://localhost:6379/0

[google_sign_in]
# The client id and secret reach the container as GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# (scripts/run_prod.sh, from KeePassXC). The redirect URI must be registered on that client.
enabled = true
redirect_uri = https://biz-e.app/auth/google/callback
