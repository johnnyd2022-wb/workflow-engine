# Slack watcher runtime state (thread IDs, session mapping) — machine-local, not shared
.agents/slack-watch-state.json
.agents/slack-watch-state.corrupt
.agents/reports/slack-watch/

# MR conflict watcher runtime state (per-MR attempt/status tracking) — machine-local
.agents/mr-conflict-watch-state.json
.agents/mr-conflict-watch-state.corrupt
.agents/mr-conflict-watch-state.lock
.agents/reports/mr-conflict-watch/

# Disposable per-task worktrees (entrypoint, mr-conflict-resolver, ...) — was previously
# only excluded locally via .git/info/exclude; committed here so it holds for every clone
.claude/worktrees/

# gitleaks JSON reports embed the matched secret string for every finding, so a
# committed report re-publishes every secret it found. Keep scanner output local.
.agents/reports/**/gitleaks.json

# Session sweep runtime state and raw digests — machine-local, not shared.
# The digest is derived from local session transcripts: redaction is best-effort, not a
# proof, so the raw digest stays out of git. findings-index.json is deliberately NOT
# ignored — it is the curated, reviewed artifact the MR is built on and the thing next
# week's sweep reads instead of re-deriving this week's reasoning.
.agents/session-sweep-state.json
.agents/session-sweep-state.lock
.agents/reports/session-sweep/**/digest.json
.agents/reports/session-sweep/**/digest.md
.agents/reports/session-sweep/*.log

# Worktree sweep runtime state and report — machine-local, regenerated on every run.
.agents/worktree-sweep-state.json
.agents/worktree-sweep-state.lock
.agents/reports/worktree-sweep/

# Findings index: generated state, not source. `findings_index.py sweep` rebuilds both
# from the tree and GitLab on every run, and it runs daily — committing them would put a
# churning, whole-file-rewritten artifact in the path of every parallel MR, which is
# exactly the conflict class mr-conflict-resolver already has to special-case for
# .agents/feature-index.md. The CONFIG (.agents/findings-index-config.json) is tracked;
# the state and the rendered worklist are not.
#
# NOTE: distinct from session-sweep's own findings-index.json above, which lives under
# .agents/reports/session-sweep/<week>/ and IS tracked. Same filename, different artifact:
# that one is a curated weekly review, this one is a daily-regenerated debt index.
.agents/findings-index.json
.agents/findings-index.json.tmp
.agents/findings-index.md
.agents/reports/findings-sweep/

# Coverage data (pytest-cov)
.coverage
coverage.xml
htmlcov/

# Runtime evidence file storage (org_id/execution_id dirs written by uploads, incl. tests)
app/core/evidence_storage/
app/admin_site/document_storage/

# Terraform runtime data and potentially sensitive state / plan / variable files.
terraform/**/.terraform/
terraform/**/terraform.tfstate*
terraform/**/terraform.tfstate.d/
terraform/**/errored.tfstate
terraform/**/*.tfplan
terraform/**/*.tfvars
terraform/**/*.tfvars.json
terraform/**/crash.log
terraform/**/crash.*.log
terraform/**/.env
terraform/**/__pycache__/

# Terraform CI local plans (only selected reports are uploaded as artifacts).
terraform/**/.ci/
