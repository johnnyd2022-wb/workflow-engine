# Multi-stage Dockerfile for test and production
FROM python:3.14-bookworm as base

LABEL maintainer="johnny@whistlebird.co.nz"

# Set timezone
RUN ln -snf /usr/share/zoneinfo/Pacific/Auckland /etc/localtime \
    && echo Pacific/Auckland > /etc/timezone

# Set working directory
WORKDIR /app

# Copy project files needed for dependency install
COPY pyproject.toml uv.lock ./

# Install uv
RUN pip install uv

# Sync dependencies exactly as in lockfile
RUN uv sync --frozen

# Copy the rest of your application code
COPY . .

# Test environment stage
FROM base as test
ENV ENVIRONMENT=test
EXPOSE 8001

# Optional healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f -k https://localhost:8001/healthcheck || exit 1
CMD ["uv", "run", "gunicorn", "--config", "gunicorn.conf.py", "app.app:app"]

# Admin site stage (admin.biz-e.app): the same code and dependencies, a different app.
# Internal to biz-e staff; see app/admin_site and scripts/run_admin.sh.
FROM base as admin
ENV ENVIRONMENT=prod
EXPOSE 8020
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f -k https://localhost:8020/healthcheck || exit 1
CMD ["uv", "run", "gunicorn", "--config", "gunicorn.admin.conf.py", "app.admin_site.wsgi:app"]

# Production environment stage
FROM base as production
# `prod` selects app/config/prod.ini, the same name scripts/run_prod.sh uses.
ENV ENVIRONMENT=prod
EXPOSE 8000
EXPOSE 443
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f -k https://localhost:8000/healthcheck || exit 1
CMD ["uv", "run", "gunicorn", "--config", "gunicorn.conf.py", "app.app:app"]
