# Multi-stage Dockerfile for test and production
FROM python:3.14-bookworm AS base

LABEL maintainer="johnny@whistlebird.co.nz"

# Set timezone
RUN ln -snf /usr/share/zoneinfo/Pacific/Auckland /etc/localtime \
    && echo Pacific/Auckland > /etc/timezone

# Set working directory
WORKDIR /app

# Copy project files needed for dependency install
COPY pyproject.toml uv.lock ./

# Install uv
RUN pip install uv

# Sync dependencies exactly as in lockfile
RUN uv sync --frozen

# Copy the rest of your application code.
# Deploy scripts extract the build context with umask 077 (scripts/deploy_common.sh), so files
# arrive owner-only. That is fine while the app runs as root; a non-root USER would need a
# `--chmod` here (or a chown) to read its own code.
COPY . .

# Compress the public, cacheable JS and CSS once at build time.
FROM base AS web
RUN uv run --no-sync python -m scripts.compress_public_assets

# Test environment stage
FROM web AS test
ENV ENVIRONMENT=test
# gunicorn.conf.py reads it; the app reads it too (app/api/ratelimit_store.py), so `docker exec ... workflow`
# knows how many workers share the rate limits (design review S4).
ENV WEB_CONCURRENCY=2
EXPOSE 8001

# Optional healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f -k https://localhost:8001/healthcheck || exit 1
CMD ["uv", "run", "gunicorn", "--config", "gunicorn.conf.py", "app.app:app"]

# Admin site stage (admin.biz-e.app): the same code and dependencies, a different app.
# Internal to biz-e staff; see app/admin_site and scripts/run_admin.sh.
FROM base AS admin
ENV ENVIRONMENT=prod
EXPOSE 8020
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f -k https://localhost:8020/healthcheck || exit 1
CMD ["uv", "run", "gunicorn", "--config", "gunicorn.admin.conf.py", "app.admin_site.wsgi:app"]

# Public MCP server stage (mcp.biz-e.app): the assistant-facing server, `bize_mcp/`. It talks to the
# app over HTTP and holds no database credentials or app secrets, so it takes no ENVIRONMENT and
# none of the app's config. Only this target installs the `mcp` extra (the SDK and an ASGI stack), so the
# app images stay as they were. Run by scripts/run_mcp.sh, which passes the three addresses it needs
# (BIZE_API_BASE_URL, MCP_PUBLIC_URL, BIZE_ISSUER_URL), and the shared rate-limit store's address and
# password (BIZE_RATELIMIT_URI, VALKEY_PASSWORD). Spec .agents/specs/public-mcp.md, "Deploy (8.2d)".
FROM base AS mcp
RUN uv sync --frozen --extra mcp
EXPOSE 8030
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -fs http://127.0.0.1:8030/healthz || exit 1
# --no-sync: the environment is complete as built; starting must never reach for the network.
CMD ["uv", "run", "--no-sync", "uvicorn", "bize_mcp.server:app", "--host", "0.0.0.0", "--port", "8030"]

# Production environment stage
FROM web AS production
# `prod` selects app/config/prod.ini, the same name scripts/run_prod.sh uses.
ENV ENVIRONMENT=prod
# gunicorn.conf.py reads it; the app reads it too (app/api/ratelimit_store.py), so `docker exec ... workflow`
# knows how many workers share the rate limits (design review S4).
ENV WEB_CONCURRENCY=2
EXPOSE 8000
EXPOSE 443
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f -k https://localhost:8000/healthcheck || exit 1
CMD ["uv", "run", "gunicorn", "--config", "gunicorn.conf.py", "app.app:app"]
